# Copy to .env.production.local (used by `npm run db:setup`), and set the same
# values in Netlify → Site configuration → Environment variables.
# Not .env.local: `npm run dev` loads that, and local development should use the
# embedded demo database + disk uploads, never live data.

# Supabase → Connect → Transaction pooler (port 6543). Used by the app at runtime.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase → Project Settings → API. The service role key is a secret: server-only,
# never prefixed with NEXT_PUBLIC_.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional
# SUPABASE_STORAGE_BUCKET=uploads
# DATABASE_POOL_MAX=5
